{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    {
    "type": "command",
    "key": "Age",
    "keyColor": "blue",
    "text": "diff=$(($(date +%s) - $(stat -c %Y /var/log/anaconda/anaconda.log))); echo \"$(($diff / 86400)) days, $(($diff % 86400 / 3600))h $(($diff % 3600 / 60))m $(($diff % 60))s\""
    },
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors",
  ]
}
